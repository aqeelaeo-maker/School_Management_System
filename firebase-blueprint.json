{
  "entities": {
    "School": {
      "title": "School",
      "description": "Educational institution in the multi-school system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended", "trial"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "code", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "schoolId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record enrolled in a school",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "name": { "type": "string" },
        "rollNo": { "type": "string" },
        "classId": { "type": "string" }
      },
      "required": ["name", "schoolId"]
    }
  },
  "firestore": {
    "/schools/{schoolId}": {
      "schema": "School",
      "description": "Schools collection"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles collection"
    },
    "/schools/{schoolId}/students/{studentId}": {
      "schema": "Student",
      "description": "Nested students collection"
    }
  }
}
